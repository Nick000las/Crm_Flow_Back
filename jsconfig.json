{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": false
  },
  "include": ["src/**/*.js", "scripts/**/*.js", "*.config.js"],
  "exclude": ["node_modules", "prisma"]
}
