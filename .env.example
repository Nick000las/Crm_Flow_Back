NODE_ENV=development
APP_NAME=crm-flow-back
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Necessária para rotas que acessam o banco e para migrations.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

JWT_SECRET="troque-por-um-segredo-com-pelo-menos-32-caracteres"
JWT_REFRESH_SECRET="troque-por-outro-segredo-com-pelo-menos-32-caracteres"

# SMTP usado para enviar o código de ativação dos usuários convidados.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=senha-smtp
