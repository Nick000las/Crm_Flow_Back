NODE_ENV=development
APP_NAME=crm-flow-back
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Necessária para rotas que acessam o banco e para migrations. Conecta como
# o role dono das tabelas (acesso cross-tenant de propósito, só pra
# operações administrativas — provisionamento/gestão de tenant).
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Role `app_tenant` (migration 0004_tenant_role_least_privilege), sem
# privilégio de dono — é por onde getTenantClient() conecta pra RLS ser
# garantia do Postgres, não só convenção de código. Em produção, criado
# pelo console do Neon (aba Roles), que já gera a connection string pronta.
TENANT_DATABASE_URL="postgresql://app_tenant:senha@host/banco?sslmode=require"

JWT_SECRET="troque-por-um-segredo-com-pelo-menos-32-caracteres"
JWT_REFRESH_SECRET="troque-por-outro-segredo-com-pelo-menos-32-caracteres"

# SMTP usado para enviar o código de ativação dos usuários convidados.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=senha-smtp
SMTP_TIMEOUT_MS=10000
